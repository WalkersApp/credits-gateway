# Copy to .env and fill in. Never commit .env — it is git-ignored.

NODE_ENV=production
PORT=4523
PUBLIC_URL=https://gateway.example.com

# Dedicated database. Do not point this at any other application's database.
MONGODB_URI=mongodb://127.0.0.1:27019
MONGODB_DB=wfit_gateway_preprod

# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Admin panel password (12+ characters).
ADMIN_PASSWORD=

# --- Cardano settlement -------------------------------------------------------
# preprod or preview. Mainnet is rejected at boot on purpose.
CARDANO_NETWORK=preprod
KOIOS_URL=https://preprod.koios.rest/api/v1
KOIOS_TOKEN=
# Optional. When set, Lucid builds and submits through Blockfrost and Koios becomes the
# fallback for confirmations. Without it everything runs on Koios, which needs no key.
BLOCKFROST_PROJECT_ID=
# Bech32 ed25519 signing key file, mode 600, outside the repository.
# Create it with: npm run wallet:create
SETTLEMENT_KEY_PATH=/root/.wfit-gateway/settlement.preprod.key
SETTLEMENT_VAULT_ADDRESS=
EXPLORER_BASE=https://preprod.cardanoscan.io
SETTLEMENT_CONFIRMATIONS=1
# Enable the preprod USDCx settlement asset once the vault holds some.
SETTLEMENT_USDCX_ENABLED=false

# tUSDM, a Cardano preprod TEST asset used as settlement test liquidity. It is
# not production USDM: its CIP-68 metadata is self-asserted, the subject is not
# in the Cardano Foundation preprod token registry, and no issuer relationship
# exists. Enable it only to run the preprod settlement demonstration.
SETTLEMENT_TUSDM_ENABLED=false
# Demonstration rate: 1 credit settles as 1 tUSDM. Test configuration only.
SETTLEMENT_RATE_TUSDM_BPS=10000

# --- Funding routes -----------------------------------------------------------
CARDANO_DEPOSITS_ENABLED=true
CARDANO_DEPOSIT_ADDRESS=
CARDANO_DEPOSIT_CONFIRMATIONS=3

SEPOLIA_ENABLED=true
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_USDC_CONTRACT=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
SEPOLIA_DEPOSIT_ADDRESS=
SEPOLIA_CONFIRMATIONS=3

CEX_DEPOSITS_ENABLED=true
CEX_EXCHANGES=Binance,Bybit,Kraken,Coinbase

# --- Fees, limits, reserve thresholds (integer base units, 1 credit = 1000000) --
DEPOSIT_FEE_FLAT_UNITS=0
DEPOSIT_FEE_BPS=0
WITHDRAWAL_FEE_FLAT_UNITS=250000
WITHDRAWAL_FEE_BPS=50
MIN_WITHDRAWAL_UNITS=1000000
MAX_WITHDRAWAL_UNITS=500000000

# Defaults for every settlement asset.
RESERVE_MIN_UNITS=10000000
RESERVE_TARGET_UNITS=100000000
RESERVE_CRITICAL_UNITS=3000000
# Per-asset overrides, e.g. RESERVE_TADA_MIN_UNITS or RESERVE_TUSDM_PREPROD_TARGET_UNITS.
# tUSDM defaults are sized for preprod test liquidity: critical 10, minimum 50, target 200 tUSDM.
# Anything not set here falls back to the defaults above.

BACKGROUND_JOBS=true
JOB_INTERVAL_MS=20000
